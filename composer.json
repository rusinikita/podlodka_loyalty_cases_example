{
    "name": "shnyr/loyalty",
    "type": "project",
    "description": "Loyalty program backend: promo codes, discounts, referral rewards",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-pcntl": "*",
        "ext-pdo_pgsql": "*",
        "ext-rdkafka": "*",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^11.31",
        "symfony/yaml": "^7.1"
    },
    "require-dev": {
        "kwn/php-rdkafka-stubs": "^2.2",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
